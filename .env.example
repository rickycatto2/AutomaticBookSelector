ABS_URL=https://your-audiobookshelf-server
ABS_TOKEN=replace-with-your-personal-api-key
# Optional: limit sync to comma-separated library IDs. Default: all book libraries.
ABS_LIBRARY_IDS=
SYNC_INTERVAL_SECONDS=900
# Startup imports the newest CSV only if no Goodreads seed has been imported.
GOODREADS_IMPORT_DIR=.
DATA_DIR=./data
PORT=5077
# Optional phone access. Public requests fail closed unless all are configured.
APP_PUBLIC_ORIGIN=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_EMAILS=
# Optional dedicated tunnel files outside the repo (use forward slashes on Windows).
CF_TUNNEL_CONFIG_PATH=./.cloudflare/config.yml
CF_TUNNEL_CREDENTIALS_PATH=./.cloudflare/tunnel.json
# Email delivery: Brevo SMTP key, NOT your account password. Never commit real values.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_TO=
# Reminders remain off until enabled inside the app.
# Optional OpenAI recommendations. Keep the real key in your private .env only.
OPENAI_API_KEY=
# Model and the maximum $5 USD monthly app allowance are enforced in ai.py.
